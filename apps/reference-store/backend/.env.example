# Copy to .env for `npm run dev`. scripts/reference-store.sh sets these for you locally.
DATABASE_URL=postgres://postgres@localhost:54329/ace_store
STORE_CORS=http://localhost:8000,http://localhost:5173
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000
JWT_SECRET=change-me
COOKIE_SECRET=change-me
# Storefront base URL: product links, PayHere return/cancel pages.
STOREFRONT_URL=http://localhost:8000
# Public URL of this backend: PayHere notify_url is ${BACKEND_URL}/hooks/payment/payhere_payhere
BACKEND_URL=http://localhost:9000
# PayHere (sandbox until the owner provides live credentials). Leave empty to disable the provider.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
# ACE webhook v1 to the engine (product, inventory and order events). Leave empty to disable.
# URL: <engine>/webhooks/<storeId>. Secret: from POST /admin/tenants/:tenantId/stores/:storeId/webhook-secret.
ACE_WEBHOOK_URL=
ACE_WEBHOOK_SECRET=
# Set to true to build and serve the Medusa admin dashboard on /app.
MEDUSA_ADMIN=false
