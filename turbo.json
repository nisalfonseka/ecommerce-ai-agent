{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["tsconfig.base.json", "biome.json"],
  "tasks": {
    "test": {
      "dependsOn": ["^typecheck"],
      "env": [
        "ACE_TEST_DATABASE_URL",
        "ACE_REQUIRE_DB_TESTS",
        "ACE_MEDUSA_SEED_OUTPUT",
        "ACE_REQUIRE_MEDUSA_TESTS"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
