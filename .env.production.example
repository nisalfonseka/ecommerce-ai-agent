# Copy to .env.production on the server (never commit it). Generate secrets with:  openssl rand -base64 32
ACE_DOMAIN=staging.example.lk
POSTGRES_PASSWORD=
# 16-128 characters of A-Z a-z 0-9 _ -
ACE_APP_DB_PASSWORD=
# base64 of exactly 32 random bytes: openssl rand -base64 32
ACE_MASTER_KEY=
# sha256 hex of your admin API key: printf %s "$ADMIN_KEY" | sha256sum
ADMIN_API_KEY_SHA256=
# at least 32 characters
CONVERSATION_TOKEN_SECRET=
# Model provider keys (only the ones your bots use)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
